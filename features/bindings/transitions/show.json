{
  "$schema": "https://raw.githubusercontent.com/francisdb/cuelight/main/crates/cuelight/schemas/show.schema.json",
  "format": 1,
  "name": "binding_transitions",
  "size": [640, 360],
  "background": "#0E1116",
  "variables": {"level": 0, "feed": 50, "score": 0, "lamp": "off", "credits": 6},
  "layers": [
    {
      "name": "title", "type": "digits", "digits": 19, "size": [266, 20], "x": 24, "y": 18, "text": "BINDING TRANSITIONS",
      "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}
    },
    {
      "name": "jumping_caption", "type": "digits", "digits": 19, "size": [152, 12], "x": 24, "y": 52, "text": "LEVEL, NO TRANSITION",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "jumping", "type": "group", "x": 24, "y": 69, "clip": {"rect": [0, 0, 360, 14]},
      "children": [
        {"name": "back", "type": "shape", "shape": {"rect": [0, 0, 360, 14]}, "fill": "#161B22"},
        {
          "name": "fill", "type": "shape", "shape": {"rect": [0, 0, 360, 14]}, "fill": "#8B96A5", "x": -360,
          "bindings": [{"property": "x", "variable": "level", "scale": 3.6, "offset": -360}]
        }
      ]
    },
    {
      "name": "easing_caption", "type": "digits", "digits": 22, "size": [176, 12], "x": 24, "y": 90, "text": "LEVEL, 400 MS CUBIC_OUT",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "easing", "type": "group", "x": 24, "y": 107, "clip": {"rect": [0, 0, 360, 14]},
      "children": [
        {"name": "back", "type": "shape", "shape": {"rect": [0, 0, 360, 14]}, "fill": "#161B22"},
        {
          "name": "fill", "type": "shape", "shape": {"rect": [0, 0, 360, 14]}, "fill": "#3EC9F0", "x": -360,
          "bindings": [{"property": "x", "variable": "level", "scale": 3.6, "offset": -360, "transition": {"duration": 0.4, "ease": "cubic_out"}}]
        }
      ]
    },
    {
      "name": "kicking_caption", "type": "digits", "digits": 40, "size": [320, 12], "x": 24, "y": 128,
      "text": "LEVEL, QUAD_IN, OFFSET 10 PX PAST AND BACK", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "kicking", "type": "group", "x": 24, "y": 145, "clip": {"rect": [0, 0, 360, 14]},
      "children": [
        {"name": "back", "type": "shape", "shape": {"rect": [0, 0, 360, 14]}, "fill": "#161B22"},
        {
          "name": "fill", "type": "shape", "shape": {"rect": [0, 0, 360, 14]}, "fill": "#A78BFA", "x": -360,
          "bindings": [
            {
              "property": "x", "variable": "level", "scale": 3.6, "offset": -360,
              "transition": {
                "duration": 0.3, "ease": "quad_in",
                "offset": [{"t": 0.3, "v": 0}, {"t": 0.37, "v": 10, "ease": "quad_out"}, {"t": 0.5, "v": 0, "ease": "quad_in"}]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "stepping_caption", "type": "digits", "digits": 23, "size": [184, 12], "x": 24, "y": 166, "text": "FEED, SET TWICE A SECOND",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {"name": "stepping_rail", "type": "shape", "shape": {"rect": [0, 0, 360, 2]}, "fill": "#232A34", "x": 24, "y": 189},
    {
      "name": "stepping", "type": "shape", "shape": {"circle": [0, 0, 7]}, "fill": "#8B96A5", "x": 34, "y": 190,
      "bindings": [{"property": "x", "variable": "feed", "scale": 3.4, "offset": 34}]
    },
    {
      "name": "following_caption", "type": "digits", "digits": 45, "size": [360, 12], "x": 24, "y": 204,
      "text": "FEED, 500 MS LINEAR - ONE STEP LATE, BUT MOVING", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {"name": "following_rail", "type": "shape", "shape": {"rect": [0, 0, 360, 2]}, "fill": "#232A34", "x": 24, "y": 227},
    {
      "name": "following", "type": "shape", "shape": {"circle": [0, 0, 7]}, "fill": "#4ADE80", "x": 34, "y": 228,
      "bindings": [{"property": "x", "variable": "feed", "scale": 3.4, "offset": 34, "transition": {"duration": 0.5, "ease": "linear"}}]
    },
    {"name": "reel_wrap_frame", "type": "shape", "shape": {"rect": [0, 0, 66, 86]}, "fill": "#2A313C", "x": 429, "y": 61},
    {
      "name": "reel_wrap", "type": "image", "image": "reel", "sheet": {"cell": [48, 64], "columns": 10}, "size": [60, 80], "x": 432, "y": 64,
      "bindings": [
        {
          "property": "frame", "variable": "credits", "scale": 16, "offset": 0.5,
          "transition": {
            "duration": 0.12, "ease": "quad_in", "step": 16, "wrap": 160, "direction": "forward",
            "offset": [{"t": 0.12, "v": 0}, {"t": 0.16, "v": 1, "ease": "quad_out"}, {"t": 0.21, "v": 0, "ease": "quad_in"}]
          }
        }
      ]
    },
    {
      "name": "reel_wrap_caption_1", "type": "digits", "digits": 9, "size": [72, 12], "x": 418, "y": 156, "text": "WRAP, STEP,",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "reel_wrap_caption_2", "type": "digits", "digits": 6, "size": [48, 12], "x": 418, "y": 172, "text": "OFFSET",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {"name": "reel_plain_frame", "type": "shape", "shape": {"rect": [0, 0, 66, 86]}, "fill": "#2A313C", "x": 545, "y": 61},
    {
      "name": "reel_plain", "type": "image", "image": "reel", "sheet": {"cell": [48, 64], "columns": 10}, "size": [60, 80], "x": 548,
      "y": 64,
      "bindings": [{"property": "frame", "variable": "credits", "scale": 16, "offset": 0.5, "transition": {"duration": 0.3, "ease": "quad_in_out"}}]
    },
    {
      "name": "reel_plain_caption_1", "type": "digits", "digits": 7, "size": [56, 12], "x": 534, "y": 156, "text": "NO WRAP,",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "reel_plain_caption_2", "type": "digits", "digits": 8, "size": [64, 12], "x": 534, "y": 172, "text": "ONE MOVE",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "label_credits", "type": "digits", "digits": 7, "size": [56, 12], "x": 432, "y": 40, "text": "CREDITS",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "score", "type": "digits", "digits": 9, "size": [342, 56], "x": 24, "y": 250, "text": "0", "justify": "right",
      "display": {"segments": {"style": "numeric7", "fill": "#FFB000", "unlit": "#2A1D04"}},
      "bindings": [{"property": "text", "variable": "score", "format": "thousands", "transition": {"duration": 0.8, "ease": "cubic_out"}}]
    },
    {
      "name": "label_score_counts_up_in_whole", "type": "digits", "digits": 32, "size": [256, 12], "x": 24, "y": 318,
      "text": "SCORE COUNTS UP, IN WHOLE NUMBERS", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "lamp", "type": "shape", "shape": {"circle": [0, 0, 30]}, "fill": "#FF5A5A", "x": 490, "y": 268, "opacity": 0.12,
      "bindings": [
        {
          "property": "opacity", "variable": "lamp", "map": {"on": 1}, "default": 0.12,
          "transition": {"duration": 0.3, "ease": "quad_in_out"}
        }
      ]
    },
    {
      "name": "label_lamp_mapped", "type": "digits", "digits": 11, "size": [88, 12], "x": 540, "y": 256, "text": "LAMP, MAPPED",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "label_then_faded", "type": "digits", "digits": 10, "size": [80, 12], "x": 540, "y": 272, "text": "THEN FADED",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    }
  ]
}
