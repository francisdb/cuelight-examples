          "name": "mode", "type": "digits", "digits": 7, "size": [91, 16], "x": 124, "y": 0, "text": "NO REST",
          "display": {"segments": {"style": "alpha14", "fill": "#FFB000"}}, "opacity": 0.45,
          "bindings": [{"property": "opacity", "variable": "row", "map": {"none": 1}, "default": 0.45}]
