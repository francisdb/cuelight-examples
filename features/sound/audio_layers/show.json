{
  "$schema": "https://raw.githubusercontent.com/francisdb/cuelight/main/crates/cuelight/schemas/show.schema.json",
  "format": 1,
  "name": "audio_layers",
  "size": [640, 360],
  "background": "#0E1116",
  "variables": {"volume": 1, "policy": "overlap"},
  "layers": [
    {
      "name": "title", "type": "digits", "digits": 12, "size": [168, 20], "x": 24, "y": 18, "text": "AUDIO LAYERS",
      "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}
    },
    {
      "name": "label_music", "type": "digits", "digits": 27, "size": [270, 14], "x": 24, "y": 56,
      "text": "AUTOPLAY MUSIC LOOP IN GAME", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "label_volume", "type": "digits", "digits": 26, "size": [260, 12], "x": 24, "y": 74,
      "text": "GROUP GAIN BOUND TO VOLUME", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "volume_bar", "type": "group", "x": 300, "y": 58, "clip": {"rect": [0, 0, 200, 24]},
      "children": [
        {"name": "back", "type": "shape", "shape": {"rect": [0, 0, 200, 24]}, "fill": "#161B22"},
        {
          "name": "level", "type": "shape", "shape": {"rect": [0, 0, 200, 24]}, "fill": "#4ADE80", "x": 0,
          "bindings": [{"property": "x", "variable": "volume", "scale": 200, "offset": -200, "transition": {"duration": 0.4}}]
        }
      ]
    },
    {
      "name": "hush_flash", "type": "shape", "shape": {"rect": [0, 0, 116, 24]}, "fill": "#FF5A5A", "x": 508, "y": 58, "opacity": 0.12,
      "timelines": [{"name": "flash", "trigger": "hush", "tracks": [
        {"property": "opacity", "keys": [{"t": 0, "v": 0.8}, {"t": 0.6, "v": 0.12, "ease": "quad_in"}]}
      ]}]
    },
    {
      "name": "label_hush", "type": "digits", "digits": 10, "size": [100, 12], "x": 516, "y": 64, "text": "HUSH STOPS",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "label_zap", "type": "digits", "digits": 28, "size": [280, 14], "x": 24, "y": 100,
      "text": "THREE ZAPS 400MS APART UNDER", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "policy", "type": "digits", "digits": 7, "size": [84, 16], "x": 318, "y": 99, "text": "",
      "display": {"segments": {"style": "alpha14", "fill": "#FFB000"}}, "bindings": [{"property": "text", "variable": "policy"}]
    },
    {
      "name": "label_ends", "type": "digits", "digits": 29, "size": [290, 12], "x": 24, "y": 120,
      "text": "A LAMP FLASHES AS A PLAY ENDS", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "zap_in", "type": "shape", "shape": {"circle": [0, 0, 8]}, "fill": "#E6EDF3", "x": 580, "y": 106, "opacity": 0.12,
      "timelines": [{"name": "flash", "trigger": ["zap_overlap", "zap_restart", "zap_ignore", "zap_queue"], "tracks": [
        {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.2, "v": 0.12, "ease": "quad_in"}]}
      ]}]
    },
    {
      "name": "label_in", "type": "digits", "digits": 2, "size": [20, 12], "x": 552, "y": 100, "text": "IN",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "zap_overlap", "type": "group", "x": 90, "y": 152, "opacity": 0.35,
      "bindings": [{"property": "opacity", "variable": "policy", "map": {"overlap": 1}, "default": 0.35}],
      "children": [
        {"name": "sound", "type": "audio", "sound": "zap", "trigger": "zap_overlap", "retrigger": "overlap", "voices": 3, "on_end": "zap_end_overlap"},
        {
          "name": "lamp", "type": "shape", "shape": {"circle": [0, 0, 14]}, "fill": "#FFB000", "opacity": 0.2,
          "timelines": [{"name": "flash", "trigger": "zap_end_overlap", "tracks": [
            {"property": "scale", "keys": [{"t": 0, "v": 1.4}, {"t": 0.2, "v": 1, "ease": "cubic_out"}]},
            {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.2, "v": 0.2, "ease": "quad_in"}]}
          ]}]
        },
        {"name": "name", "type": "digits", "digits": 9, "size": [90, 12], "x": -45, "y": 20, "text": "OVERLAP 3", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {"name": "what", "type": "digits", "digits": 9, "size": [90, 12], "x": -45, "y": 34, "text": "ALL SOUND", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },
    {
      "name": "zap_restart", "type": "group", "x": 240, "y": 152, "opacity": 0.35,
      "bindings": [{"property": "opacity", "variable": "policy", "map": {"restart": 1}, "default": 0.35}],
      "children": [
        {"name": "sound", "type": "audio", "sound": "zap", "trigger": "zap_restart", "retrigger": "restart", "on_end": "zap_end_restart"},
        {
          "name": "lamp", "type": "shape", "shape": {"circle": [0, 0, 14]}, "fill": "#3EC9F0", "opacity": 0.2,
          "timelines": [{"name": "flash", "trigger": "zap_end_restart", "tracks": [
            {"property": "scale", "keys": [{"t": 0, "v": 1.4}, {"t": 0.2, "v": 1, "ease": "cubic_out"}]},
            {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.2, "v": 0.2, "ease": "quad_in"}]}
          ]}]
        },
        {"name": "name", "type": "digits", "digits": 7, "size": [70, 12], "x": -35, "y": 20, "text": "RESTART", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {"name": "what", "type": "digits", "digits": 13, "size": [130, 12], "x": -65, "y": 34, "text": "CUTS THE LAST", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },
    {
      "name": "zap_ignore", "type": "group", "x": 390, "y": 152, "opacity": 0.35,
      "bindings": [{"property": "opacity", "variable": "policy", "map": {"ignore": 1}, "default": 0.35}],
      "children": [
        {"name": "sound", "type": "audio", "sound": "zap", "trigger": "zap_ignore", "retrigger": "ignore", "on_end": "zap_end_ignore"},
        {
          "name": "lamp", "type": "shape", "shape": {"circle": [0, 0, 14]}, "fill": "#FF5A5A", "opacity": 0.2,
          "timelines": [{"name": "flash", "trigger": "zap_end_ignore", "tracks": [
            {"property": "scale", "keys": [{"t": 0, "v": 1.4}, {"t": 0.2, "v": 1, "ease": "cubic_out"}]},
            {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.2, "v": 0.2, "ease": "quad_in"}]}
          ]}]
        },
        {"name": "name", "type": "digits", "digits": 6, "size": [60, 12], "x": -30, "y": 20, "text": "IGNORE", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {"name": "what", "type": "digits", "digits": 10, "size": [100, 12], "x": -50, "y": 34, "text": "FIRST ONLY", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },
    {
      "name": "zap_queue", "type": "group", "x": 540, "y": 152, "opacity": 0.35,
      "bindings": [{"property": "opacity", "variable": "policy", "map": {"queue": 1}, "default": 0.35}],
      "children": [
        {"name": "sound", "type": "audio", "sound": "zap", "trigger": "zap_queue", "retrigger": "queue", "on_end": "zap_end_queue"},
        {
          "name": "lamp", "type": "shape", "shape": {"circle": [0, 0, 14]}, "fill": "#4ADE80", "opacity": 0.2,
          "timelines": [{"name": "flash", "trigger": "zap_end_queue", "tracks": [
            {"property": "scale", "keys": [{"t": 0, "v": 1.4}, {"t": 0.2, "v": 1, "ease": "cubic_out"}]},
            {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.2, "v": 0.2, "ease": "quad_in"}]}
          ]}]
        },
        {"name": "name", "type": "digits", "digits": 5, "size": [50, 12], "x": -25, "y": 20, "text": "QUEUE", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {"name": "what", "type": "digits", "digits": 10, "size": [100, 12], "x": -50, "y": 34, "text": "ONE BY ONE", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },
    {
      "name": "label_thunder", "type": "digits", "digits": 40, "size": [400, 14], "x": 24, "y": 224,
      "text": "THUNDER DELAY 500MS REPEAT 2 ON_END LAMP", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {"name": "thunder", "type": "audio", "sound": "thunder", "trigger": "strike", "delay": 0.5, "repeat": 2, "on_end": "thunder_done", "gain": 0.9},
    {
      "name": "strike_flash", "type": "shape", "shape": {"rect": [0, 0, 60, 24]}, "fill": "#E6EDF3", "x": 440, "y": 220, "opacity": 0.15,
      "timelines": [{"name": "flash", "trigger": "strike", "tracks": [
        {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.4, "v": 0.15, "ease": "quad_in"}]}
      ]}]
    },
    {
      "name": "label_strike", "type": "digits", "digits": 6, "size": [60, 12], "x": 440, "y": 248, "text": "STRIKE",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "done_lamp", "type": "shape", "shape": {"circle": [0, 0, 14]}, "fill": "#4ADE80", "x": 560, "y": 232, "opacity": 0.12,
      "timelines": [{"name": "lit", "trigger": "thunder_done", "tracks": [
        {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 1.5, "v": 1}, {"t": 2.2, "v": 0.12, "ease": "quad_in"}]}
      ]}]
    },
    {
      "name": "label_done", "type": "digits", "digits": 4, "size": [40, 12], "x": 540, "y": 248, "text": "DONE",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "label_scenes", "type": "digits", "digits": 48, "size": [480, 12], "x": 24, "y": 286,
      "text": "EACH SCENE HAS ITS OWN LOOP AND LEAVING IT STOPS", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "label_scenes_2", "type": "digits", "digits": 49, "size": [490, 12], "x": 24, "y": 304,
      "text": "THE MUSIC STOPS IN ATTRACT AND THE JINGLE IN GAME", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    }
  ],
  "scenes": [
    {
      "name": "game", "trigger": "game",
      "layers": [
        {
          "name": "music", "type": "group", "gain": 1,
          "bindings": [{"property": "gain", "variable": "volume", "transition": {"duration": 0.4}}],
          "children": [
            {"name": "loop", "type": "audio", "sound": "music", "autoplay": true, "loop": true, "stop": "hush", "gain": 0.7}
          ]
        },
        {
          "name": "scene_label", "type": "digits", "digits": 10, "size": [120, 16], "x": 500, "y": 326, "text": "SCENE GAME",
          "display": {"segments": {"style": "alpha14", "fill": "#4ADE80"}}
        }
      ]
    },
    {
      "name": "attract", "trigger": "attract",
      "layers": [
        {
          "name": "dim", "type": "shape", "shape": {"rect": [0, 0, 640, 360]}, "fill": "#0E1116", "opacity": 0,
          "timelines": [{"name": "fade", "autoplay": true, "hold": true, "tracks": [
            {"property": "opacity", "keys": [{"t": 0, "v": 0}, {"t": 0.4, "v": 0.75, "ease": "quad_out"}]}
          ]}]
        },
        {"name": "jingle", "type": "audio", "sound": "jingle", "autoplay": true, "loop": true, "gain": 0.6},
        {
          "name": "scene_label", "type": "digits", "digits": 13, "size": [156, 16], "x": 464, "y": 326, "text": "SCENE ATTRACT",
          "display": {"segments": {"style": "alpha14", "fill": "#3EC9F0"}}
        }
      ]
    }
  ]
}
