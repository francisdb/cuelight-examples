{
  "$schema": "https://raw.githubusercontent.com/francisdb/cuelight/main/crates/cuelight/schemas/show.schema.json",
  "format": 1,
  "name": "font_binding",
  "size": [640, 360],
  "background": "#0E1116",
  "variables": {"player": 1, "score_1": 0, "score_2": 0},
  "fonts": {"active": {"file": "Oxanium-Bold", "size": 64, "color": "#FFB000"}, "inactive": {"file": "Oxanium-Bold", "size": 64, "color": "#3A4350"}},
  "layers": [
    {
      "name": "title", "type": "digits", "digits": 12, "size": [168, 20], "x": 24, "y": 18, "text": "FONT BINDING",
      "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}
    },
    {
      "name": "player_1_label", "type": "digits", "digits": 8, "size": [112, 20], "x": 40, "y": 90, "text": "PLAYER 1",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "player_1_score", "type": "text", "text": "0", "font": "inactive", "x": 40, "y": 120, "size": [260, 90], "align": "left",
      "bindings": [
        {"property": "text", "variable": "score_1", "format": "thousands"},
        {"property": "font", "variable": "player", "map": {"1": "active"}, "default": "inactive"}
      ]
    },
    {
      "name": "player_2_label", "type": "digits", "digits": 8, "size": [112, 20], "x": 350, "y": 90, "text": "PLAYER 2",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "player_2_score", "type": "text", "text": "0", "font": "inactive", "x": 350, "y": 120, "size": [260, 90], "align": "left",
      "bindings": [
        {"property": "text", "variable": "score_2", "format": "thousands"},
        {"property": "font", "variable": "player", "map": {"2": "active"}, "default": "inactive"}
      ]
    },
    {
      "name": "label_player", "type": "digits", "digits": 8, "size": [88, 16], "x": 40, "y": 270, "text": "PLAYER =",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "player", "type": "digits", "digits": 1, "size": [22, 32], "x": 140, "y": 262, "text": "1",
      "display": {"segments": {"style": "numeric7", "fill": "#FFB000", "unlit": "#2A1D04"}},
      "bindings": [{"property": "text", "variable": "player"}]
    },
    {
      "name": "label_the_font_style_is_mapped", "type": "digits", "digits": 42, "size": [336, 12], "x": 40, "y": 320,
      "text": "THE FONT STYLE IS MAPPED FROM THE VARIABLE", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    }
  ]
}
