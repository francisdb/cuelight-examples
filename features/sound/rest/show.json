          ]}]
        },
        {
          "name": "played", "type": "shape", "shape": {"circle": [90, 8, 12]}, "fill": "#FFB000", "opacity": 0.15,
          "timelines": [{"name": "flash", "trigger": "played_none", "tracks": [
            {"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.08, "v": 0.15, "ease": "quad_in"}]}
          ]}]
        },
