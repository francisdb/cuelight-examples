{
  "$schema": "https://raw.githubusercontent.com/francisdb/cuelight/main/crates/cuelight/schemas/show.schema.json",
  "format": 1,
  "name": "pinball_dmd",
  "size": [128, 32],
  "background": "#000000",
  "output": { "scaling": "pixel_perfect" },
  "fonts": {
    "tiny_white": { "file": "tiny5-8", "color": "#FFFFFF" },
    "tiny_gray64": { "file": "tiny5-8", "color": "#404040" },
    "tiny_gray128": { "file": "tiny5-8", "color": "#808080" },
    "title_white": { "file": "jersey20-20", "color": "#FFFFFF" },
    "title_ice": {
      "file": "jersey20-20",
      "color": "#E6FFFF",
      "border": { "color": "#102C80", "width": 1 }
    },
    "title_sky": {
      "file": "jersey20-20",
      "color": "#C8E6FF",
      "border": { "color": "#000000", "width": 1 }
    }
  },
  "variables": {
    "player": 1,
    "score_1": 0,
    "score_2": 0,
    "score_3": 0,
    "score_4": 0,
    "video_score": 0
  },
  "scenes": [
    {
      "name": "welcome",
      "trigger": "welcome",
      "output": { "mode": "gray4", "tint": "#FF5820" },
      "layers": [
        {
          "name": "title",
          "type": "text",
          "font": "title_white",
          "text": "... Cuelight ...",
          "size": [128, 16]
        },
        {
          "name": "info",
          "type": "text",
          "font": "tiny_white",
          "text": "Use Left and Right Magna\nto select Demo",
          "y": 18,
          "size": [128, 14]
        },
        {
          "name": "left",
          "type": "text",
          "font": "title_white",
          "text": "<",
          "x": 3,
          "y": 32,
          "anchor": "bottom_left",
          "timelines": [
            {
              "name": "blink",
              "autoplay": true,
              "loop": true,
              "tracks": [
                {
                  "property": "opacity",
                  "keys": [
                    { "t": 0.0, "v": 0 },
                    { "t": 0.5, "v": 1, "ease": "step" },
                    { "t": 1.0, "v": 0, "ease": "step" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "right",
          "type": "text",
          "font": "title_white",
          "text": ">",
          "x": 125,
          "y": 32,
          "anchor": "bottom_right",
          "timelines": [
            {
              "name": "blink",
              "autoplay": true,
              "loop": true,
              "tracks": [
                {
                  "property": "opacity",
                  "keys": [
                    { "t": 0.0, "v": 1 },
                    { "t": 0.5, "v": 0, "ease": "step" },
                    { "t": 1.0, "v": 1, "ease": "step" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "stern",
      "trigger": "stern",
      "output": { "mode": "gray4", "tint": "#FF5820" },
      "layers": [
        {
          "name": "score_1",
          "type": "text",
          "font": "tiny_gray64",
          "text": "0",
          "x": 45,
          "y": 1,
          "anchor": "top_right",
          "bindings": [
            { "property": "text", "variable": "score_1", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "1": "tiny_white" }, "default": "tiny_gray64" }
          ]
        },
        {
          "name": "score_2",
          "type": "text",
          "font": "tiny_gray64",
          "text": "0",
          "x": 45,
          "y": 7,
          "anchor": "top_right",
          "bindings": [
            { "property": "text", "variable": "score_2", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "2": "tiny_white" }, "default": "tiny_gray64" }
          ]
        },
        {
          "name": "score_3",
          "type": "text",
          "font": "tiny_gray64",
          "text": "0",
          "x": 45,
          "y": 13,
          "anchor": "top_right",
          "bindings": [
            { "property": "text", "variable": "score_3", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "3": "tiny_white" }, "default": "tiny_gray64" }
          ]
        },
        {
          "name": "score_4",
          "type": "text",
          "font": "tiny_gray64",
          "text": "0",
          "x": 45,
          "y": 19,
          "anchor": "top_right",
          "bindings": [
            { "property": "text", "variable": "score_4", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "4": "tiny_white" }, "default": "tiny_gray64" }
          ]
        },
        {
          "name": "separator",
          "type": "shape",
          "shape": { "rect": [0, 0, 1, 32] },
          "fill": "#FFFFFF",
          "x": 45
        },
        {
          "name": "content",
          "type": "group",
          "x": 47,
          "clip": { "rect": [0, 0, 81, 32] },
          "children": [
            {
              "name": "title",
              "type": "text",
              "font": "title_white",
              "text": ">>> Cuelight <<<",
              "x": -11,
              "y": 10,
              "timelines": [
                {
                  "name": "scroll",
                  "autoplay": true,
                  "loop": true,
                  "tracks": [
                    {
                      "property": "x",
                      "keys": [
                        { "t": 0.0, "v": -11 },
                        { "t": 3.0, "v": 128, "ease": "step" },
                        { "t": 3.5, "v": 128 },
                        { "t": 8.5, "v": -128 },
                        { "t": 9.0, "v": -128 }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "ball",
              "type": "text",
              "font": "tiny_gray64",
              "text": "Ball 1",
              "x": 0,
              "y": 33,
              "anchor": "bottom_left"
            },
            {
              "name": "credit",
              "type": "text",
              "font": "tiny_gray64",
              "text": "Credit 5",
              "x": 81,
              "y": 33,
              "anchor": "bottom_right"
            }
          ]
        }
      ]
    },
    {
      "name": "williams",
      "trigger": "williams",
      "output": { "mode": "gray4", "tint": "#FF5820" },
      "layers": [
        {
          "name": "score_1",
          "type": "text",
          "font": "tiny_gray128",
          "text": "0",
          "x": 0,
          "y": 0,
          "anchor": "top_left",
          "bindings": [
            { "property": "text", "variable": "score_1", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "1": "title_white" }, "default": "tiny_gray128" }
          ]
        },
        {
          "name": "score_2",
          "type": "text",
          "font": "tiny_gray128",
          "text": "0",
          "x": 128,
          "y": 0,
          "anchor": "top_right",
          "bindings": [
            { "property": "text", "variable": "score_2", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "2": "title_white" }, "default": "tiny_gray128" }
          ]
        },
        {
          "name": "score_3",
          "type": "text",
          "font": "tiny_gray128",
          "text": "0",
          "x": 0,
          "y": 24,
          "anchor": "bottom_left",
          "bindings": [
            { "property": "text", "variable": "score_3", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "3": "title_white" }, "default": "tiny_gray128" }
          ]
        },
        {
          "name": "score_4",
          "type": "text",
          "font": "tiny_gray128",
          "text": "0",
          "x": 128,
          "y": 24,
          "anchor": "bottom_right",
          "bindings": [
            { "property": "text", "variable": "score_4", "format": "thousands" },
            { "property": "font", "variable": "player", "map": { "4": "title_white" }, "default": "tiny_gray128" }
          ]
        },
        {
          "name": "ball",
          "type": "text",
          "font": "tiny_gray128",
          "text": "Ball 1",
          "x": 2,
          "y": 33,
          "anchor": "bottom_left"
        },
        {
          "name": "credit",
          "type": "text",
          "font": "tiny_gray128",
          "text": "Credit 5",
          "x": 126,
          "y": 33,
          "anchor": "bottom_right"
        }
      ]
    },
    {
      "name": "colors",
      "trigger": "colors",
      "output": { "mode": "rgb" },
      "layers": [
        {
          "name": "title",
          "type": "text",
          "font": "title_ice",
          "text": "- Cuelight -",
          "size": [128, 20]
        },
        {
          "name": "lightning",
          "type": "image",
          "image": "lightning",
          "sheet": { "cell": [128, 24], "columns": 1 },
          "y": 8,
          "timelines": [
            {
              "name": "flash",
              "autoplay": true,
              "loop": true,
              "tracks": [
                {
                  "property": "frame",
                  "keys": [
                    { "t": 0.0, "v": 0 },
                    { "t": 0.8, "v": 8 }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "graveyard",
      "trigger": "graveyard",
      "output": { "mode": "rgb" },
      "layers": [
        {
          "name": "background",
          "type": "image",
          "image": "gy_background"
        },
        {
          "name": "foreground_1",
          "type": "image",
          "image": "gy_graveyard",
          "timelines": [
            {
              "name": "scroll",
              "autoplay": true,
              "loop": true,
              "delay": 2.0,
              "tracks": [
                {
                  "property": "x",
                  "keys": [
                    { "t": 0.0, "v": 0 },
                    { "t": 15.0, "v": -384 }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "foreground_2",
          "type": "image",
          "image": "gy_graveyard",
          "x": 384,
          "timelines": [
            {
              "name": "scroll",
              "autoplay": true,
              "loop": true,
              "delay": 2.0,
              "tracks": [
                {
                  "property": "x",
                  "keys": [
                    { "t": 0.0, "v": 384 },
                    { "t": 15.0, "v": 0 }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "girl",
          "type": "image",
          "image": "gy_girl",
          "sheet": { "cell": [19, 19], "columns": 8 },
          "x": 15,
          "y": 8,
          "timelines": [
            {
              "name": "run",
              "autoplay": true,
              "loop": true,
              "tracks": [
                {
                  "property": "frame",
                  "keys": [
                    { "t": 0.0, "v": 0 },
                    { "t": 0.128, "v": 8 }
                  ]
                }
              ]
            },
            {
              "name": "intro",
              "autoplay": true,
              "repeat": 12.5,
              "tracks": [
                {
                  "property": "frame",
                  "keys": [
                    { "t": 0.0, "v": 28 },
                    { "t": 0.16, "v": 38 }
                  ]
                }
              ]
            },
            {
              "name": "jump",
              "trigger": "jump",
              "tracks": [
                {
                  "property": "y",
                  "keys": [
                    { "t": 0.0, "v": 8 },
                    { "t": 0.512, "v": -8, "ease": "quad_out" },
                    { "t": 1.024, "v": 8, "ease": "quad_in" }
                  ]
                }
              ]
            },
            {
              "name": "jump_frames",
              "trigger": "jump",
              "repeat": 6.4,
              "tracks": [
                {
                  "property": "frame",
                  "keys": [
                    { "t": 0.0, "v": 8 },
                    { "t": 0.16, "v": 18 }
                  ]
                }
              ]
            },
            {
              "name": "fall",
              "trigger": "fall",
              "on_end": "graveyard",
              "tracks": [
                {
                  "property": "frame",
                  "keys": [
                    { "t": 0.0, "v": 18 },
                    { "t": 0.576, "v": 27 },
                    { "t": 1.92, "v": 27 }
                  ]
                },
                {
                  "property": "x",
                  "keys": [
                    { "t": 0.0, "v": 15 },
                    { "t": 1.92, "v": -33 }
                  ]
                },
                {
                  "property": "y",
                  "keys": [
                    { "t": 0.0, "v": 8 },
                    { "t": 1.92, "v": 48 }
                  ]
                }
              ]
            },
            {
              "name": "die",
              "trigger": "die",
              "on_end": "graveyard",
              "tracks": [
                {
                  "property": "frame",
                  "keys": [
                    { "t": 0.0, "v": 18 },
                    { "t": 0.576, "v": 27 },
                    { "t": 2.56, "v": 27 }
                  ]
                },
                {
                  "property": "x",
                  "keys": [
                    { "t": 0.0, "v": 15 },
                    { "t": 2.56, "v": -65 }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "title",
          "type": "text",
          "font": "title_sky",
          "text": "Video Mode",
          "size": [128, 24],
          "opacity": 0,
          "timelines": [
            {
              "name": "intro",
              "autoplay": true,
              "tracks": [
                {
                  "property": "opacity",
                  "keys": [
                    { "t": 0.0, "v": 1 },
                    { "t": 2.0, "v": 0, "ease": "step" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "infos",
          "type": "text",
          "font": "tiny_white",
          "text": "Use Launch Button to jump !",
          "y": 25,
          "size": [128, 7],
          "opacity": 0,
          "timelines": [
            {
              "name": "blink",
              "autoplay": true,
              "tracks": [
                {
                  "property": "opacity",
                  "keys": [
                    { "t": 0.0, "v": 1 },
                    { "t": 0.5, "v": 0, "ease": "step" },
                    { "t": 0.75, "v": 1, "ease": "step" },
                    { "t": 1.0, "v": 0, "ease": "step" },
                    { "t": 1.25, "v": 1, "ease": "step" },
                    { "t": 1.5, "v": 0, "ease": "step" },
                    { "t": 1.75, "v": 1, "ease": "step" },
                    { "t": 2.0, "v": 0, "ease": "step" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "score",
          "type": "text",
          "font": "tiny_white",
          "text": "0",
          "x": 126,
          "y": 32,
          "anchor": "bottom_right",
          "bindings": [
            { "property": "text", "variable": "video_score", "format": "thousands" }
          ],
          "timelines": [
            {
              "name": "intro",
              "autoplay": true,
              "tracks": [
                {
                  "property": "opacity",
                  "keys": [
                    { "t": 0.0, "v": 0 },
                    { "t": 2.0, "v": 1, "ease": "step" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "alphanum",
      "trigger": "alphanum",
      "output": { "mode": "rgb" },
      "layers": [
        {
          "name": "row_1",
          "type": "digits",
          "digits": 16,
          "size": [128, 16],
          "text": "    CUELIGHT",
          "display": { "segments": { "style": "alpha14", "fill": "#FF5820", "unlit": "#1F0B04" } }
        },
        {
          "name": "row_2",
          "type": "digits",
          "digits": 16,
          "size": [128, 16],
          "y": 16,
          "text": "",
          "display": { "segments": { "style": "alpha14", "fill": "#FF5820", "unlit": "#1F0B04" } }
        }
      ]
    }
  ]
}
