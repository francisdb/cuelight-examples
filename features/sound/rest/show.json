    },
    {
      "name": "footer_2", "type": "digits", "digits": 49, "size": [490, 12], "x": 24, "y": 328,
      "text": "SECOND AND REST DROPS WHAT ARRIVES TOO SOON AFTER", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
