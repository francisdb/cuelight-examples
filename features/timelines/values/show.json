{
  "$schema": "https://raw.githubusercontent.com/francisdb/cuelight/main/crates/cuelight/schemas/show.schema.json",
  "format": 1,
  "name": "values",
  "size": [640, 360],
  "background": "#0E1116",
  "values": {
    "breath": {
      "timelines": [
        {
          "name": "loop",
          "autoplay": true,
          "loop": true,
          "keys": [{"t": 0, "v": 0.6}, {"t": 1.5, "v": 1.2, "ease": "quad_in_out"}, {"t": 3, "v": 0.6, "ease": "quad_in_out"}]
        }
      ]
    },
    "level": {
      "timelines": [
        {"name": "rise", "autoplay": true, "trigger": "again", "on_end": "top", "keys": [{"t": 0, "v": 0}, {"t": 2, "v": 100, "ease": "quad_out"}]},
        {"name": "stay", "trigger": "top", "on_end": "down", "keys": [{"t": 0, "v": 100}, {"t": 1.5, "v": 100}]},
        {"name": "fall", "trigger": "down", "on_end": "again", "keys": [{"t": 0, "v": 100}, {"t": 2, "v": 0, "ease": "quad_in"}]}
      ]
    },
    "sweep": {
      "timelines": [
        {
          "name": "loop",
          "autoplay": true,
          "loop": true,
          "keys": [{"t": 0, "v": 0}, {"t": 2, "v": 100, "ease": "quad_in_out"}, {"t": 4, "v": 0, "ease": "quad_in_out"}]
        }
      ]
    }
  },
